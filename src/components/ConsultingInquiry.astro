---
import { inquiryDescription, inquiryHref, inquiryTitle } from '../lib/consulting';
interface Props {
  service?: string;
}
const { service = 'general' } = Astro.props;
---

<section class="consulting-inquiry" id="project-inquiry" aria-labelledby="inquiry-heading">
  <h2 id="inquiry-heading">{inquiryTitle}</h2>
  <p>{inquiryDescription}</p>
  <div class="consulting-actions">
    <a class="consulting-button" href={inquiryHref(service)} data-consulting-service={service}>
      Email me about a project <span aria-hidden="true">↗</span>
    </a>
    <a class="consulting-text-link" href={`/contact?service=${service}`}
      >Other ways to get in touch →</a
    >
  </div>
</section>
