---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/software', label: 'Software' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const profiles = [
  { href: 'https://github.com/peritissimus', label: 'GitHub' },
  { href: 'https://linkedin.com/in/peritissimus', label: 'LinkedIn' },
  { href: 'https://twitter.com/peritissimus_', label: 'X' },
];
---

<footer class="footer">
  <div class="footer-copy">Kushal Patankar &copy; {new Date().getFullYear()}</div>
  <nav class="footer-nav" aria-label="Footer">
    {
      links.map((link) => (
        <a href={link.href} class:list={[{ active: currentPath.startsWith(link.href) }]}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <nav class="footer-profiles" aria-label="Professional profiles">
    {
      profiles.map((profile) => (
        <a href={profile.href} rel="me noopener noreferrer">
          {profile.label}
        </a>
      ))
    }
  </nav>
</footer>
