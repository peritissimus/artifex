---
import maze from '../data/wedding-maze.json';
interface Props {
  solution?: boolean;
}
const { solution = false } = Astro.props;
const walls: string[] = [];
for (let r = 0; r < maze.rows; r++) {
  for (let c = 0; c < maze.cols; c++) {
    const i = r * maze.cols + c;
    if (r === 0) walls.push(`M${c},${r}h1`);
    if (c === 0 && r !== 0) walls.push(`M${c},${r}v1`);
    if (r === maze.rows - 1 || !maze.links[i].includes(i + maze.cols))
      walls.push(`M${c},${r + 1}h1`);
    if (
      (c === maze.cols - 1 && r !== maze.rows - 1) ||
      (c < maze.cols - 1 && !maze.links[i].includes(i + 1))
    )
      walls.push(`M${c + 1},${r}v1`);
  }
}
const route = maze.route
  .map((i) => `${(i % maze.cols) + 0.5},${Math.floor(i / maze.cols) + 0.5}`)
  .join(' ');
---

<svg
  class:list={['travel-maze', { solution }]}
  viewBox={`-.4 -.4 ${maze.cols + 0.8} ${maze.rows + 0.8}`}
  role="img"
  aria-label={solution
    ? 'Solution to the travel maze, through the Rishikesh checkpoint'
    : 'Travel maze: enter at the top left, pass the R checkpoint, and exit at the bottom right'}
>
  <path
    d={walls.join(' ')}
    fill="none"
    stroke="currentColor"
    stroke-width=".055"
    stroke-linecap="square"></path>
  {
    solution && (
      <polyline
        points={`-.3,.5 ${route} ${maze.cols + 0.3},${maze.rows - 0.5}`}
        fill="none"
        stroke="currentColor"
        stroke-width=".1"
        stroke-dasharray=".12 .1"
      />
    )
  }
  <circle
    cx={(maze.waypoint % maze.cols) + 0.5}
    cy={Math.floor(maze.waypoint / maze.cols) + 0.5}
    r=".35"
    fill="#20201d"></circle>
  <text
    x={(maze.waypoint % maze.cols) + 0.5}
    y={Math.floor(maze.waypoint / maze.cols) + 0.66}
    text-anchor="middle"
    font-family="Georgia,serif"
    font-size=".47"
    fill="#f7f4ec">R</text
  >
  {
    !solution && (
      <>
        <>
          <path
            d="M-.35 .5H.6m-.2-.15L.6 .5l-.2 .15"
            fill="none"
            stroke="currentColor"
            stroke-width=".07"
          />
          <path
            d={`M${maze.cols - 0.6} ${maze.rows - 0.5}h.85m-.2-.15l.2 .15l-.2 .15`}
            fill="none"
            stroke="currentColor"
            stroke-width=".07"
          />
        </>
      </>
    )
  }
</svg>
<style>
  .travel-maze {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
