---
import { servicesForContent, servicePath } from '../lib/consulting';
interface Props {
  path: string;
}
const services = servicesForContent(Astro.props.path);
---

{
  services.length > 0 && (
    <aside class="contact-related" aria-labelledby="contact-related-heading">
      <h2 id="contact-related-heading">Working on a similar problem?</h2>
      <p>I’m open to focused engineering conversations around these systems.</p>
      <ul>
        {services.map((service) => (
          <li>
            <a href={servicePath(service)}>{service.name} →</a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
