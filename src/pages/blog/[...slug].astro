---
import Base from '../../layouts/Base.astro';
import { relatedPosts } from '../../lib/related-posts';
import { getCollection, render } from 'astro:content';
import { blogPostingSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = relatedPosts(post.id, await getCollection('blog'));
const contents = headings.filter((heading) => heading.depth === 2);

const publishedIso = post.data.date.toISOString();
const modifiedIso = post.data.updated?.toISOString();
const ogImage = post.data.ogImage || `/og/blog/${post.id}.png`;
const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : undefined;
const postSchema = blogPostingSchema({
  title: post.data.title,
  description: post.data.description,
  slug: post.id,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  author: post.data.author,
  image: ogImage,
  tags: post.data.tags,
  category: post.data.category,
  wordCount,
});
const breadcrumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: post.data.title, path: `/blog/${post.id}` },
]);

function formatDate(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}
---

<Base
  title={`${post.data.title} - peritissimus`}
  ogTitle={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  currentPath={`/blog/${post.id}`}
  type="article"
  publishedDate={publishedIso}
  modifiedDate={modifiedIso}
  author={post.data.author}
  jsonLd={[postSchema, breadcrumbs]}
>
  <article class="content-section blog-post">
    <div class="section-inner">
      <div class="post-header">
        <div class="post-back">
          <a href="/blog">← Back to blog</a>
        </div>

        <div class="post-meta-header">
          <time class="post-date" datetime={formatDate(post.data.date)}>
            {formatDate(post.data.date)}
          </time>
          <span class="post-tag">{post.data.category || 'AI/LLM'}</span>
        </div>

        <h1 class="post-title">{post.data.title}</h1>

        <div class="post-info">
          <a class="post-author" href="/about" rel="author"
            >{post.data.author || 'Kushal Patankar'}</a
          >
          <span class="meta-separator" aria-hidden="true">/</span>
          <span class="post-read-time">{post.data.readTime || '5 min read'}</span>
          <span class="meta-separator" aria-hidden="true">/</span>
          <span class="post-topics">{post.data.tags.join(', ')}</span>
        </div>
      </div>

      {
        contents.length > 2 && (
          <nav class="post-content" aria-label="On this page">
            <details>
              <summary>On this page</summary>
              <ul>
                {contents.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
        )
      }

      <div class="post-content">
        <Content />
      </div>

      {
        related.length > 0 && (
          <nav class="post-content" aria-labelledby="related-reading-title">
            <h2 id="related-reading-title">Continue reading</h2>
            <ul>
              {related.map((entry) => (
                <li>
                  <a href={`/blog/${entry.id}`}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
            <p>
              Explore <a href="/software">personal software projects and practical guides</a>.
            </p>
          </nav>
        )
      }

      <div class="post-footer-nav">
        <a href="/blog" class="nav-link">← All posts</a>
      </div>
    </div>
  </article>
</Base>
