---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { blogIndexSchema, breadcrumbSchema } from '../../lib/schema';

// Get all blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

function formatDate(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

const indexSchema = blogIndexSchema(
  sortedPosts.map((post) => ({ title: post.data.title, slug: post.id }))
);
const breadcrumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
]);
---

<Base
  title="Personal Software, Local AI & Engineering Guides - peritissimus"
  description="Build personal software with practical guides by Kushal Patankar: local AI, searchable notes, X bookmark archives, and the engineering behind them."
  ogImage="/og/blog.png"
  currentPath="/blog"
  jsonLd={[indexSchema, breadcrumbs]}
>
  <section id="blog" class="content-section page-blog">
    <div class="section-inner">
      <div class="blog-header">
        <div class="blog-header-top">
          <span class="blog-label">Engineering notes</span>
          <span class="blog-count">
            <span class="count-indicator"></span>
            {sortedPosts.length}
            {sortedPosts.length === 1 ? 'post' : 'posts'}
          </span>
        </div>
        <h1 class="section-title">Blog</h1>
        <p class="blog-description">
          Notes on personal software, local AI, and the engineering behind useful tools.
        </p>
      </div>

      <div class="blog-grid">
        {
          sortedPosts.map((post) => (
            <article class="blog-card">
              <a
                href={`/blog/${post.id}`}
                class="blog-card-link"
                aria-labelledby={`blog-title-${post.id}`}
                aria-describedby={`blog-description-${post.id}`}
              >
                <div class="blog-card-header">
                  <time class="blog-date" datetime={formatDate(post.data.date)}>
                    {formatDate(post.data.date)}
                  </time>
                </div>
                <div class="blog-card-body">
                  <h2 id={`blog-title-${post.id}`} class="blog-title">
                    {post.data.title}
                  </h2>
                  <p id={`blog-description-${post.id}`} class="blog-excerpt">
                    {post.data.description}
                  </p>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
