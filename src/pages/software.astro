---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { softwareCards, softwareProjects } from '../lib/projects';
import { personalSoftware } from '../lib/personal-software';

const projects = softwareProjects(await getCollection('work'));
---

<Base
  title="Personal Software Projects by Kushal Patankar - peritissimus"
  description={personalSoftware.description}
  ogImage="/og/home.png"
  currentPath="/software"
  wide
>
  <section class="content-section page-software">
    <div class="section-inner">
      <header class="software-header">
        <p class="page-kicker">Independent work</p>
        <h1 class="section-title">Personal software</h1>
        <p class="software-intro">{personalSoftware.intro}</p>
      </header>

      <section class="software-reading" aria-labelledby="software-reading-title">
        <h2 id="software-reading-title">{personalSoftware.heading}</h2>
        <p>{personalSoftware.explanation}</p>
        <ol>
          {
            personalSoftware.guides.map((guide) => (
              <li>
                <a href={guide.href}>
                  <span class="software-reading-label">{guide.label}</span>
                  <span class="software-reading-copy">
                    <strong>{guide.title}</strong>
                    <span>{guide.description}</span>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="software-grid">
        {
          projects.map((project, i) => {
            const meta = softwareCards[project.id as keyof typeof softwareCards];
            return (
              <a
                class={`software-card ${meta.className}`}
                style={`--card-serial: "Nº ${String(i + 1).padStart(2, '0')}"`}
                href={`/work/${project.id}`}
                aria-label={`${project.data.title}: ${project.data.description}`}
              >
                <ProjectArtwork variant={meta.mark} />
                <span class="project-card-copy">
                  <span class="project-card-heading">
                    <strong>{project.data.title}</strong>
                    <span class="project-card-date">{project.data.dateRange}</span>
                  </span>
                  <span class="project-card-blurb">{project.data.description}</span>
                </span>
                <span class="project-card-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
