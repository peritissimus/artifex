---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/barlow-semi-condensed/600.css';
import WeddingAgra from '../components/WeddingAgra.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f4ec" />
    <title>Kush &amp; Aru — Save the Date · 24 November 2026 · Agra</title>
    <meta
      name="description"
      content="The wedding issue. Kush & Aru, 24 November 2026, Agra. An A2 newspaper spread for our forever."
    />
  </head>
  <body>
    <div class="tools">
      <div>
        <strong>Our wedding newspaper</strong><p>The wedding issue · Kush &amp; Aru</p>
      </div><button id="print" type="button"
        >Print / Save PDF <span aria-hidden="true">↗</span></button
      >
    </div>
    <p class="print-note">
      One A2 sheet · print both sides at 100% · flip on the short edge · fold down the middle
    </p>
    <main aria-label="Four-page wedding newspaper, arranged for double-sided printing">
      <p class="side-label">
        <strong>Outside</strong><span>Back cover · 04 &nbsp; | &nbsp; Front cover · 01</span>
      </p>
      <div
        class="preview-scroll outside-preview"
        role="region"
        aria-label="Outside spread: pages 4 and 1; scroll horizontally on a small screen"
        tabindex="0"
      >
        <section class="spread" aria-label="Outside of the A2 sheet">
          <div class="spread-content">
            <header class="masthead">
              <p class="publication">THE FOREVER TIMES</p>
              <div class="issue-line">
                <span>Agra, India</span><span>The Wedding Issue</span><span>November 24, 2026</span>
              </div>
            </header>
            <section class="announcement" aria-labelledby="save-heading">
              <h1 id="save-heading">SAVE THE DATE</h1>
              <p>Some stories are meant to last a lifetime.</p>
            </section>
            <div class="pages">
              <section class="page details" aria-label="Page 4: back cover, wedding details">
                <p class="eyebrow">Together with our families</p>
                <h2>Kush <span>&amp;</span> Aru</h2>
                <p class="marrying">are getting married.</p>
                <div class="ornament" aria-hidden="true">❦</div>
                <p class="date">24 NOVEMBER<br /><strong>2026</strong></p>
                <p class="location">AGRA, INDIA</p>
                <footer><span>Formal invitation to follow</span><span>04</span></footer>
              </section>
              <section class="page portrait" aria-label="Page 1: front cover, our photograph">
                <figure>
                  <img
                    src="/wedding/couple-placeholder.png"
                    alt="Sample photograph: an AI-generated couple laughing together in an Agra-inspired courtyard"
                    width="1774"
                    height="887"
                    loading="eager"
                  />
                  <figcaption>Sample photograph · Your favourite photo goes here</figcaption>
                </figure>
                <p class="photo-quote">“The beginning of<br /><em>our favourite chapter.”</em></p>
                <p class="photo-note">A lifetime of love, laughter, and the little things.</p>
                <footer><span>With love, Kush &amp; Aru</span><span>01</span></footer>
              </section>
            </div>
          </div>
        </section>
      </div>
      <p class="side-label inside-label">
        <strong>Inside</strong><span>Left page · 02 &nbsp; | &nbsp; Right page · 03</span>
      </p>
      <div
        class="preview-scroll inside-preview"
        role="region"
        aria-label="Inside spread: pages 2 and 3; scroll horizontally on a small screen"
        tabindex="0"
      >
        <section class="spread inner-spread" aria-label="Inside of the A2 sheet">
          <div class="spread-content">
            <header class="masthead">
              <p class="publication">THE FOREVER TIMES</p><div class="issue-line">
                <span>A note from the couple</span><span>The Wedding Issue</span><span
                  >November 24, 2026</span
                >
              </div>
            </header>
            <div class="announcement inner-announcement">
              <h2>A LIFE TOGETHER</h2><p>Love, laughter, and everything in between.</p>
            </div>
            <div class="pages">
              <section class="page letter" aria-label="Page 2: a note from Kush and Aru">
                <p class="eyebrow">To our favourite people</p>
                <h3>Some things are better<br /><em>when we share them.</em></h3>
                <div class="letter-copy">
                  <p>
                    We’re getting married. And as we begin this next chapter, what we look forward
                    to most is having the people we love beside us.
                  </p><p>
                    So keep the twenty-fourth of November for us. Bring your joy, your dancing
                    shoes, and yourselves. We’ll make the memories together.
                  </p><p>
                    Here’s to a day full of laughter, a room full of love, and a lifetime of little
                    moments worth keeping.
                  </p>
                </div>
                <p class="signature">With love,<br /><em>Kush &amp; Aru</em></p>
                <footer><span>The beginning of our favourite chapter</span><span>02</span></footer>
              </section>
              <section class="page destination" aria-label="Page 3: meet us in Agra">
                <p class="eyebrow">The city of our celebration</p><h3>Meet us in <em>Agra.</em></h3>
                <figure class="city-art">
                  <WeddingAgra /><figcaption>A city made for a love story.</figcaption>
                </figure>
                <p class="destination-date">24 NOVEMBER 2026</p><p class="destination-note">
                  The place, the plans, and all the lovely details<br />will arrive with your formal
                  invitation.
                </p>
                <footer><span>Agra, India · Keep this day for us</span><span>03</span></footer>
              </section>
            </div>
          </div>
        </section>
      </div>
    </main>
    <p class="screen-caption">One sheet. Four pages. A story to keep.</p>
    <script>
      document.querySelector<HTMLButtonElement>('#print')?.addEventListener('click', async () => {
        await document.fonts.ready;
        await Promise.all(Array.from(document.images, (image) => image.decode().catch(() => {})));
        window.print();
      });
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  :global(html) {
    color-scheme: light;
    background: #dedbd3;
    color: #20201d;
  }
  :global(body) {
    padding: 28px;
    font-family: 'Newsreader', Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(::selection) {
    background: #803f35;
    color: #fff;
  }
  .tools {
    max-width: 1440px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .tools strong {
    font-size: 19px;
    font-weight: 400;
  }
  .tools p {
    font-size: 14px;
    color: #635f56;
    font-style: italic;
    margin-top: 6px;
  }
  button {
    min-height: 44px;
    padding: 12px 18px;
    background: #20201d;
    color: #f7f4ec;
    border: 0;
    font:
      12px 'Barlow Semi Condensed',
      sans-serif;
    letter-spacing: 0.7px;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 150ms,
      transform 150ms;
  }
  button:hover {
    background: #514b40;
  }
  button:active {
    transform: scale(0.96);
  }
  button:focus-visible,
  .preview-scroll:focus-visible {
    outline: 2px solid #803f35;
    outline-offset: 4px;
  }
  .print-note {
    max-width: 1440px;
    margin: 18px auto;
    font:
      12px 'Barlow Semi Condensed',
      sans-serif;
    color: #635f56;
    letter-spacing: 0.3px;
  }
  .side-label {
    max-width: 1440px;
    margin: 20px auto 12px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font:
      12px 'Barlow Semi Condensed',
      sans-serif;
    letter-spacing: 0.5px;
  }
  .inside-label {
    margin-top: 36px;
  }
  .inner-announcement h2 {
    font-size: 6.5cqw;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.1cqw;
    margin: 0;
  }
  .letter {
    padding-right: 3cqw;
    border-right: 0.08cqw solid #aaa397;
  }
  .destination {
    padding-left: 3cqw;
    text-align: center;
  }
  .letter h3,
  .destination h3 {
    font-size: 3.2cqw;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.08cqw;
    margin: 1.4cqw 0 1.2cqw;
  }
  .letter-copy {
    font-size: 1.4cqw;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .letter-copy p {
    margin-bottom: 1.3cqw;
  }
  .letter-copy p:first-child:first-letter {
    float: left;
    font-size: 5.7cqw;
    line-height: 0.85;
    padding: 0.55cqw 0.5cqw 0 0;
  }
  .signature {
    font-size: 1.8cqw;
    line-height: 1.4;
    margin-top: 0.5cqw;
  }
  .signature em {
    font-size: 3cqw;
  }
  .city-art {
    width: 70%;
    margin: 0 auto;
  }
  .city-art :global(svg) {
    max-height: 17cqw;
  }
  .destination-date {
    font:
      2.8cqw 'Barlow Semi Condensed',
      sans-serif;
    margin-top: 1.7cqw;
  }
  .destination-note {
    font-size: 1.45cqw;
    line-height: 1.45;
    font-style: italic;
    margin-top: 1cqw;
  }
  .preview-scroll {
    max-width: 1440px;
    margin: auto;
    box-shadow:
      0 2px 8px #00000008,
      0 20px 60px #00000014;
  }
  .spread {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 574/399;
    background: #f7f4ec;
  }
  .spread-content {
    position: absolute;
    inset: 2.6cqw 3.1cqw 1.8cqw;
    display: flex;
    flex-direction: column;
  }
  .masthead {
    text-align: center;
  }
  .publication {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 400;
    font-size: 6.8cqw;
    line-height: 1;
    letter-spacing: 0.38cqw;
    white-space: nowrap;
    padding: 0.5cqw 0 1.2cqw;
  }
  .issue-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
    padding: 0.85cqw 0;
    border-block: 0.08cqw solid;
    font:
      1.02cqw 'Barlow Semi Condensed',
      sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.12cqw;
  }
  .issue-line span:nth-child(2) {
    color: #8c3f32;
    letter-spacing: 0.2cqw;
  }
  .announcement {
    text-align: center;
    padding: 2cqw 0 1.6cqw;
    flex-shrink: 0;
  }
  h1 {
    font-size: 10cqw;
    word-spacing: 0.6cqw;
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.38cqw;
    white-space: nowrap;
    margin: 0;
  }
  .announcement > p {
    font-size: 1.55cqw;
    font-style: italic;
    margin-top: 0.35cqw;
  }
  .pages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
    min-height: 0;
    border-top: 0.08cqw solid;
  }
  .page {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-top: 2.2cqw;
  }
  .details {
    padding-right: 3cqw;
    text-align: center;
    border-right: 0.08cqw solid #aaa397;
  }
  .portrait {
    padding-left: 3cqw;
  }
  .eyebrow,
  .date,
  .location,
  figcaption,
  footer {
    font-family: 'Barlow Semi Condensed', sans-serif;
    text-transform: uppercase;
  }
  .eyebrow {
    font-size: 1cqw;
    letter-spacing: 0.18cqw;
    color: #8c3f32;
  }
  h2 {
    font-size: 6.6cqw;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.2cqw;
    margin: 1.45cqw 0 0.3cqw;
    white-space: nowrap;
  }
  h2 > span {
    font-style: italic;
    font-size: 0.8em;
    padding: 0 0.35cqw;
  }
  .marrying {
    font-size: 2.15cqw;
    font-style: italic;
  }
  .ornament {
    font-size: 3.2cqw;
    line-height: 1;
    margin: 1.35cqw 0 1cqw;
  }
  .date {
    font-size: 3.45cqw;
    line-height: 1.02;
    letter-spacing: 0.05cqw;
  }
  .date strong {
    font-family: 'Newsreader', serif;
    font-size: 5.7cqw;
    font-weight: 400;
    letter-spacing: -0.15cqw;
    display: inline-block;
    margin-top: 0.4cqw;
  }
  .location {
    font-size: 1.6cqw;
    letter-spacing: 0.35cqw;
    margin-top: 0.6cqw;
  }
  .note {
    font-size: 1.5cqw;
    line-height: 1.45;
    margin-top: 1.55cqw;
    text-wrap: pretty;
  }
  .note em {
    display: inline-block;
    margin-top: 0.45cqw;
  }
  figure {
    width: 100%;
    flex-shrink: 0;
  }
  figure img {
    display: block;
    width: 100%;
    height: 19.7cqw;
    object-fit: cover;
    object-position: 52% 35%;
    filter: grayscale(1);
    outline: 1px solid rgba(0, 0, 0, 0.1);
    outline-offset: -1px;
  }
  figcaption {
    font-size: 0.75cqw;
    letter-spacing: 0.08cqw;
    margin-top: 0.65cqw;
    text-align: center;
  }
  .photo-quote {
    font-size: 3cqw;
    line-height: 1.14;
    letter-spacing: -0.05cqw;
    text-align: center;
    margin-top: 1.8cqw;
  }
  .photo-note {
    font-size: 1.3cqw;
    text-align: center;
    margin-top: 0.85cqw;
    font-style: italic;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 1.5cqw;
    font-size: 0.8cqw;
    letter-spacing: 0.07cqw;
    margin-top: auto;
    padding-top: 1cqw;
    border-top: 0.08cqw solid #aaa397;
  }
  .screen-caption {
    text-align: center;
    font-size: 15px;
    font-style: italic;
    color: #635f56;
    margin: 20px 0;
  }
  @media screen and (max-width: 800px) {
    :global(body) {
      padding: 16px;
    }
    .preview-scroll {
      overflow-x: auto;
    }
    .spread {
      min-width: 720px;
    }
    .print-note {
      line-height: 1.5;
    }
    .tools strong {
      font-size: 17px;
    }
    .tools p {
      font-size: 12px;
    }
    button {
      font-size: 11px;
      padding: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
  @page {
    size: 594mm 420mm;
    margin: 10mm;
  }
  @media print {
    :global(html),
    :global(body) {
      padding: 0;
      margin: 0;
      background: white;
    }
    .tools,
    .side-label,
    .print-note,
    .screen-caption,
    :global(astro-dev-toolbar) {
      display: none;
    }
    .preview-scroll {
      width: 574mm;
      max-width: none;
      box-shadow: none;
      overflow: visible;
      break-inside: avoid;
    }
    .outside-preview {
      break-after: page;
    }
    .spread {
      width: 574mm;
      height: 399mm;
      aspect-ratio: auto;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      break-inside: avoid;
    }
  }
</style>
