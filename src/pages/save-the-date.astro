---
import '@fontsource/unifrakturmaguntia/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/libre-baskerville/400.css';
import WeddingBookletPage from '../components/WeddingBookletPage.astro';
const sheets = [
  {
    name: 'Outer sheet',
    description: 'Page 4 · back cover | Page 1 · save the date',
    instruction: 'Fold with the printed side facing out.',
    pages: [4, 1] as const,
  },
  {
    name: 'Inner sheet',
    description: 'Page 2 · crossword & word groups | Page 3 · maze & mischief',
    instruction: 'Fold with the printed side facing in, then nest inside the outer sheet.',
    pages: [2, 3] as const,
  },
];
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex, nofollow" /><meta
      name="theme-color"
      content="#f7f4ec"
    /><title>Aru &amp; Kush — Save the Date · 24 November 2026 · Agra</title><meta
      name="description"
      content="The Forever Times. A wedding newspaper on two A2 sheets, printed single-sided and folded into four printed A3 pages."
    /></head
  >
  <body>
    <div class="tools">
      <div>
        <strong>Our wedding newspaper</strong><p>
          Two A2 sheets · Single-sided printing · Four printed A3 pages
        </p>
      </div><button id="print" type="button">Print / Save PDF ↗</button>
    </div>
    <p class="print-note">
      A2 landscape (594 × 420 mm), actual size / 100%. Print each sheet on one side only. Fold both
      down the centre and nest them with the blank backs together. The two cover photos are
      placeholders.
    </p>
    <main aria-label="Two single-sided A2 print sheets for a folded wedding newspaper">
      {
        sheets.map((sheet) => (
          <section class="sheet-section" aria-label={sheet.name}>
            <>
              <div class="sheet-label">
                <>
                  <strong>{sheet.name}</strong>
                  <span>{sheet.description}</span>
                </>
              </div>
              <p class="fold-note">{sheet.instruction}</p>
              <div
                class="preview"
                tabindex="0"
                role="region"
                aria-label={`${sheet.name}, two A3 pages; scroll horizontally on a small screen`}
              >
                <div class="sheet">
                  {sheet.pages.map((page) => (
                    <WeddingBookletPage page={page} />
                  ))}
                </div>
              </div>
            </>
          </section>
        ))
      }
    </main>
    <p class="screen-caption">
      Outside: 4 | 1 &nbsp; · &nbsp; Inside: 2 | 3 &nbsp; · &nbsp; No printing on the reverse.
    </p>
    <script>
      document.querySelector<HTMLButtonElement>('#print')?.addEventListener('click', async () => {
        await document.fonts.ready;
        await Promise.all(Array.from(document.images, (image) => image.decode().catch(() => {})));
        window.print();
      });
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  :global(html) {
    color-scheme: light;
    background: #dedbd3;
    color: #20201d;
  }
  :global(body) {
    padding: 28px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    -webkit-font-smoothing: antialiased;
  }
  :global(::selection) {
    background: #803f35;
    color: white;
  }
  .tools {
    max-width: 1440px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .tools strong {
    font-size: 23px;
    font-weight: 500;
  }
  .tools p,
  .print-note,
  .fold-note,
  .sheet-label,
  .screen-caption {
    font:
      12px/1.6 'Libre Baskerville',
      Georgia,
      serif;
  }
  .tools p {
    margin-top: 5px;
  }
  .print-note {
    max-width: 1440px;
    margin: 16px auto 28px;
    color: #635f56;
  }
  button {
    min-height: 44px;
    padding: 12px 18px;
    background: #20201d;
    color: #f7f4ec;
    border: 0;
    font:
      12px 'Libre Baskerville',
      Georgia,
      serif;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 150ms,
      transform 150ms;
  }
  button:hover {
    background: #514b40;
  }
  button:active {
    transform: scale(0.96);
  }
  button:focus-visible,
  .preview:focus-visible {
    outline: 2px solid #803f35;
    outline-offset: 4px;
  }
  .sheet-section {
    max-width: 1440px;
    margin: 0 auto 34px;
  }
  .sheet-label {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .fold-note {
    margin: 3px 0 10px;
    color: #635f56;
  }
  .preview {
    box-shadow:
      0 2px 8px #00000008,
      0 20px 60px #00000014;
  }
  .sheet {
    width: 100%;
    aspect-ratio: 594 / 420;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
  }
  .sheet::after {
    content: '';
    position: absolute;
    top: 3%;
    bottom: 3%;
    left: 50%;
    border-left: 1px dashed #aaa397;
    pointer-events: none;
  }
  .screen-caption {
    text-align: center;
    color: #635f56;
  }
  @media screen and (max-width: 800px) {
    :global(body) {
      padding: 12px;
    }
    .preview {
      overflow-x: auto;
    }
    .sheet {
      min-width: 960px;
    }
    .tools p {
      font-size: 10px;
    }
    .sheet-label {
      flex-direction: column;
      gap: 0;
    }
    button {
      font-size: 10px;
      padding-inline: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
  @page {
    size: 594mm 420mm;
    margin: 0;
  }
  @media print {
    :global(html),
    :global(body) {
      margin: 0;
      padding: 0;
      background: white;
    }
    .tools,
    .print-note,
    .fold-note,
    .sheet-label,
    .screen-caption,
    :global(astro-dev-toolbar) {
      display: none;
    }
    .sheet-section {
      width: 594mm;
      max-width: none;
      margin: 0;
      break-after: page;
      break-inside: avoid;
    }
    .sheet-section:last-child {
      break-after: auto;
    }
    .preview {
      width: 594mm;
      box-shadow: none;
      overflow: visible;
    }
    .sheet {
      width: 594mm;
      height: 420mm;
      aspect-ratio: auto;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .sheet::after {
      display: none;
    }
  }
</style>
