---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/barlow-semi-condensed/600.css';
import WeddingAgra from '../components/WeddingAgra.astro';
const wedding = { names: 'Kush & Aru', date: '24 November 2026', city: 'Agra' };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f5f0e5" />
    <title>Kush &amp; Aru — Save the Date · 24 November 2026 · Agra</title>
    <meta
      name="description"
      content="Kush & Aru are getting married. Save the date: 24 November 2026, Agra. A two-page wedding newspaper."
    />
  </head>
  <body>
    <div class="tools">
      <div class="tool-title">
        <strong>Our wedding newspaper</strong><p>Two pages. One forever.</p>
      </div>
      <div class="print-controls">
        <button id="print" type="button">Print / Save PDF <span aria-hidden="true">↗</span></button>
      </div>
    </div>
    <p class="print-note" id="print-note" aria-live="polite">
      One A2 landscape sheet · fold down the middle · print at 100% scale
    </p>
    <main class="spread" aria-label="Kush and Aru’s two-page save-the-date newspaper">
      <article class="paper front" aria-label="Page 1: Save the date">
        <div class="page-content">
          <header>
            <div class="topline">
              <span>The wedding edition</span><span>Some news is worth keeping.</span>
            </div>
            <div class="masthead"><span>The</span> Forever Times</div>
            <div class="edition">
              <span>Agra, India</span><span>A very special announcement</span><span>No. 01</span>
            </div>
          </header>
          <section class="cover-story" aria-labelledby="save-heading">
            <p class="eyebrow">Clear your calendar. Open your heart.</p>
            <h1 id="save-heading">
              <span>SAVE</span><span class="the">THE</span><span>DATE</span>
            </h1>
            <p class="cover-names">{wedding.names}</p>
            <p class="getting-married">are getting married!</p>
          </section>
          <div class="cover-date" aria-label={`${wedding.date}, ${wedding.city}`}>
            <strong>24.11.2026</strong><span>AGRA</span>
          </div>
          <footer><span>Kush &amp; Aru · The beginning of forever</span><span>01</span></footer>
        </div>
      </article>
      <article class="paper inside" aria-label="Page 2: Kush and Aru’s wedding announcement">
        <div class="page-content">
          <header>
            <div class="topline">
              <span>Two hearts. One beautiful beginning.</span><span>The wedding edition</span>
            </div>
            <div class="masthead"><span>The</span> Forever Times</div>
            <div class="edition">
              <span>Love, laughter &amp; happily ever after</span><span>No. 02</span>
            </div>
          </header>
          <section class="love-story" aria-labelledby="couple-heading">
            <p class="eyebrow">Extra, extra! We’re making it forever.</p>
            <h2 id="couple-heading">Kush <em>&amp;</em> Aru</h2>
            <p class="married-headline">WE’RE GETTING<br /><em>MARRIED!</em></p>
          </section>
          <figure class="agra-art">
            <WeddingAgra /><figcaption>
              Meet us in Agra. <em>A city made for a love story.</em>
            </figcaption>
          </figure>
          <section class="story-columns" aria-label="A note from the couple">
            <div>
              <h3>With full hearts.</h3><p>
                We’re beginning our forever, surrounded by our favourite people. Come for the love.
                Stay for the laughter.
              </p>
            </div><div>
              <h3>With you there.</h3><p>
                Bring your joy and your dancing shoes. We can’t wait to celebrate this beautiful new
                chapter with you.
              </p>
            </div>
          </section>
          <div class="inside-date">
            <span>Save the date</span><strong>24 NOVEMBER 2026</strong><span>AGRA, INDIA</span>
          </div>
          <footer>
            <span>Formal invitation to follow · With love, Kush &amp; Aru</span><span>02</span>
          </footer>
        </div>
      </article>
    </main>
    <p class="screen-caption">Made to hold up, unfold, and remember.</p>
    <script>
      document.querySelector<HTMLButtonElement>('#print')?.addEventListener('click', async () => {
        await document.fonts.ready;
        window.print();
      });
    </script>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  :global(html) {
    color-scheme: light;
    background: #ded9ce;
    color: #25231d;
  }
  :global(body) {
    padding: 28px;
    font-family: 'Newsreader', Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(::selection) {
    background: #5b3f36;
    color: #fff;
  }
  .tools {
    max-width: 1440px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .tool-title strong {
    font-size: 19px;
    font-weight: 400;
  }
  .tool-title p {
    font-size: 14px;
    color: #655f53;
    margin-top: 5px;
    font-style: italic;
  }
  .print-controls {
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }
  button {
    min-height: 44px;
    background: #25231d;
    color: #f5f0e5;
    padding: 12px 18px;
    border: 0;
    font:
      12px 'Barlow Semi Condensed',
      sans-serif;
    letter-spacing: 0.6px;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 150ms,
      transform 150ms;
  }
  button:hover {
    background: #514b40;
  }
  button:active {
    transform: scale(0.96);
  }
  button:focus-visible {
    outline: 2px solid #825047;
    outline-offset: 4px;
  }
  .print-note {
    max-width: 1440px;
    margin: 18px auto;
    font:
      12px 'Barlow Semi Condensed',
      sans-serif;
    letter-spacing: 0.4px;
    color: #655f53;
  }
  .spread {
    max-width: 1440px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    box-shadow:
      0 2px 8px #0000000a,
      0 20px 65px #00000018;
  }
  .paper {
    container-type: inline-size;
    aspect-ratio: 210/297;
    background: #f5f0e5;
    min-width: 0;
    position: relative;
  }
  .front {
    box-shadow: inset -12px 0 20px -20px #4b423b;
    border-right: 1px solid #b8b0a055;
  }
  .inside {
    box-shadow: inset 12px 0 20px -20px #4b423b;
  }
  .page-content {
    position: absolute;
    inset: 4.5cqw 5cqw 3cqw;
    display: flex;
    flex-direction: column;
  }
  .page-content > * {
    flex-shrink: 0;
  }
  .topline,
  .edition,
  .eyebrow,
  .getting-married,
  .cover-date,
  .inside-date,
  footer,
  figcaption {
    font-family: 'Barlow Semi Condensed', sans-serif;
    text-transform: uppercase;
  }
  .topline {
    display: flex;
    justify-content: space-between;
    gap: 2cqw;
    border-bottom: 0.15cqw solid;
    padding-bottom: 1.6cqw;
    font-size: 1.2cqw;
    letter-spacing: 0.13cqw;
  }
  .masthead {
    font-size: 7.7cqw;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.35cqw;
    text-align: center;
    padding: 2.3cqw 0 1.9cqw;
    white-space: nowrap;
  }
  .masthead > span {
    font-size: 0.6em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.15cqw;
  }
  .edition {
    display: flex;
    justify-content: space-between;
    gap: 1cqw;
    border-block: 0.45cqw double;
    padding: 1.1cqw 0;
    font-size: 1.15cqw;
    letter-spacing: 0.1cqw;
  }
  .cover-story {
    text-align: center;
    padding-top: 3.2cqw;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .eyebrow {
    font-size: 1.45cqw;
    letter-spacing: 0.22cqw;
  }
  h1 {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-weight: 600;
    line-height: 0.79;
    letter-spacing: -1cqw;
    font-size: 27cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2cqw 0 2.4cqw;
    width: 100%;
  }
  h1 > span {
    display: block;
  }
  h1 .the {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-size: 9cqw;
    line-height: 1;
    letter-spacing: -0.2cqw;
    margin: 0.9cqw 0 0.2cqw;
    font-weight: 400;
  }
  .cover-names {
    font-size: 11.7cqw;
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.4cqw;
    margin-top: 1cqw;
  }
  .getting-married {
    font-size: 2.45cqw;
    letter-spacing: 0.28cqw;
    margin: 1.4cqw 0 3cqw;
  }
  .cover-date {
    text-align: center;
    border-block: 0.5cqw double;
    padding: 2.1cqw 0 1.7cqw;
  }
  .cover-date strong {
    display: block;
    font-size: 11.9cqw;
    line-height: 1;
    letter-spacing: -0.18cqw;
    font-weight: 600;
  }
  .cover-date > span {
    display: block;
    font-size: 4.5cqw;
    letter-spacing: 1.4cqw;
    margin-top: 1.2cqw;
    padding-left: 1.4cqw;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 2cqw;
    border-top: 0.12cqw solid;
    padding-top: 1.3cqw;
    font-size: 1.15cqw;
    letter-spacing: 0.1cqw;
    margin-top: auto;
  }
  .love-story {
    text-align: center;
    padding: 2.2cqw 0 2cqw;
  }
  .love-story h2 {
    font-size: 12.5cqw;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.4cqw;
    margin: 2.1cqw 0;
  }
  .love-story h2 em {
    font-weight: 400;
    color: #754c43;
  }
  .married-headline {
    font-family: 'Barlow Semi Condensed', sans-serif;
    font-size: 7.6cqw;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.12cqw;
  }
  .married-headline em {
    font-family: 'Newsreader', serif;
    font-weight: 400;
    font-size: 10.9cqw;
    line-height: 1.15;
    letter-spacing: -0.3cqw;
  }
  .agra-art {
    width: 73%;
    margin: 0 auto 1.9cqw;
    min-height: 0;
  }
  .agra-art :global(svg) {
    max-height: 23cqw;
  }
  figcaption {
    font-size: 1.45cqw;
    text-align: center;
    letter-spacing: 0.1cqw;
    margin-top: 0.8cqw;
  }
  figcaption em {
    font-family: 'Newsreader', serif;
    font-size: 1.8cqw;
    text-transform: none;
    letter-spacing: 0;
    display: block;
    margin-top: 0.5cqw;
  }
  .story-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3cqw;
    padding: 2.4cqw 0;
    border-block: 0.12cqw solid;
  }
  .story-columns > div + div {
    border-left: 0.12cqw solid #b5ae9f;
    padding-left: 3cqw;
  }
  .story-columns h3 {
    font-size: 3.2cqw;
    font-weight: 400;
    letter-spacing: -0.08cqw;
    line-height: 1.1;
    margin-bottom: 0.9cqw;
  }
  .story-columns p {
    font-size: 1.95cqw;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .inside-date {
    text-align: center;
    padding: 2.7cqw 0;
    display: flex;
    flex-direction: column;
    gap: 1cqw;
  }
  .inside-date > span:first-child {
    font-size: 2.2cqw;
    letter-spacing: 0.4cqw;
  }
  .inside-date strong {
    font-size: 5.95cqw;
    line-height: 1;
    letter-spacing: -0.05cqw;
  }
  .inside-date > span:last-child {
    font-size: 2.5cqw;
    letter-spacing: 0.65cqw;
  }
  .screen-caption {
    text-align: center;
    font-size: 15px;
    font-style: italic;
    color: #655f53;
    margin: 22px 0 0;
  }
  @media screen and (max-width: 800px) {
    :global(body) {
      padding: 18px;
    }
    .tools {
      align-items: flex-start;
    }
    .print-controls {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .tool-title strong {
      font-size: 17px;
    }
    .spread {
      grid-template-columns: 1fr;
      max-width: 620px;
      gap: 20px;
      box-shadow: none;
    }
    .paper {
      box-shadow: 0 4px 20px #00000012;
      border: 0;
    }
    .print-note {
      line-height: 1.5;
      max-width: 620px;
    }
    .tools {
      max-width: 620px;
    }
  }
  @media screen and (max-width: 450px) {
    :global(body) {
      padding: 12px;
    }
    .tools {
      flex-direction: column;
      gap: 14px;
    }
    .print-controls {
      width: 100%;
      flex-direction: row;
      align-items: flex-end;
      gap: 8px;
    }
    button {
      font-size: 10px;
      padding-inline: 10px;
    }
    .print-note {
      font-size: 11px;
      margin: 14px 0;
    }
    .screen-caption {
      font-size: 13px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
  @page {
    size: 594mm 420mm;
    margin: 10mm;
  }
  @media print {
    :global(html),
    :global(body) {
      background: white;
      padding: 0;
      margin: 0;
    }
    .tools,
    .print-note,
    .screen-caption,
    :global(astro-dev-toolbar) {
      display: none;
    }
    .spread {
      width: 574mm;
      max-width: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      box-shadow: none;
      break-inside: avoid;
    }
    .paper {
      width: 287mm;
      height: 399mm;
      aspect-ratio: auto;
      box-shadow: none;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      break-inside: avoid;
    }
  }
</style>
