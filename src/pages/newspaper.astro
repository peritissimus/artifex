---
import { getCollection } from 'astro:content';
import SEO from '../components/SEO.astro';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/barlow-semi-condensed/600.css';

const work = (await getCollection('work', ({ data }) => data.kind === 'professional'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const projects = [
  {
    name: 'Stone',
    slug: 'stone',
    category: 'Notes & memory',
    image: 'stone.jpg',
    title: 'A little less noise. A lot more context.',
    description:
      'A local-first workspace for notes, meetings, and the things you want to remember.',
  },
  {
    name: 'Turntable',
    slug: 'turntable',
    category: 'Design tools',
    image: 'turntable.webp',
    title: 'Good software deserves a good picture.',
    description: 'A 3D device mockup studio for turning product screens into polished imagery.',
  },
  {
    name: 'Fitroom',
    slug: 'fitroom',
    category: 'Applied AI',
    image: 'fitroom.webp',
    title: 'The fitting room, reimagined.',
    description:
      'An AI try-on studio that renders couples in chosen outfits at true relative height.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2efe5" />
    <SEO
      title="The Peritissimus — A newspaper by Kushal Patankar"
      description="Products, systems, and independent experiments. The portfolio of Kushal Patankar, in print."
      noindex
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to stories</a>
    <div class="print-tools">
      <span>A paper worth keeping. <span class="print-hint">A3 portrait edition</span></span><button
        type="button"
        id="print-newspaper">Print / Save PDF <span aria-hidden="true">↗</span></button
      >
    </div>
    <div class="paper">
      <header>
        <div class="edition">
          <span>An independent publication</span><span>Engineering · Design · Applied AI</span>
        </div>
        <a class="masthead" href="/newspaper" aria-label="The Peritissimus front page"
          ><span>The</span> Peritissimus</a
        >
        <div class="dateline">
          <span>By Kushal Patankar</span><span class="motto">Good things are built with care.</span
          ><span>The portfolio edition · No. 001</span>
        </div>
        <nav aria-label="Main navigation">
          <a href="#main" aria-current="page">Front page</a><a href="/software">Software</a><a
            href="/blog">Writing</a
          ><a href="/about">About the author</a><a href="/resume">Résumé</a><a href="/contact"
            >Correspondence <span aria-hidden="true">↗</span></a
          >
        </nav>
      </header>
      <main id="main">
        <section class="lead" aria-labelledby="lead-heading">
          <div class="lead-main">
            <p class="eyebrow">The main story / Product & infrastructure</p>
            <h1 id="lead-heading">Ideas are good.<br /><em>Built is better.</em></h1>
            <p class="standfirst">I build AI products and the systems that make them scale.</p>
            <div class="lead-bottom">
              <p class="dropcap">
                I’m Kushal, a founding engineer working across product, infrastructure, and applied
                AI. Currently building tools for local businesses at Zoca. I care about software
                that feels considered, works reliably, and earns its place in someone’s day.
              </p><div class="byline">
                <span class="monogram" aria-hidden="true">kp.</span><span
                  >Words & work by<br /><strong>Kushal Patankar</strong><br /><a href="/about"
                    >Meet the engineer →</a
                  ></span
                >
              </div>
            </div>
          </div>
          <aside class="sidebar" aria-label="Editor's notes">
            <div class="sidebar-heading">From the desk</div>
            <span class="ornament" aria-hidden="true">✳</span>
            <h2>A maker<br />at heart.</h2>
            <p>
              Small tools. Useful experiments. A persistent curiosity about how things work—and how
              they could work better.
            </p>
            <a class="text-link" href="/software">Explore the workshop ↗</a>
            <div class="notice">
              <p class="eyebrow">Open for correspondence</p><p>
                Have something<br /><em>worth building?</em>
              </p><a href="/contact">Let’s talk →</a>
            </div>
          </aside>
        </section>
        <section class="workshop" aria-labelledby="workshop-heading">
          <div class="section-heading">
            <h2 id="workshop-heading">The Workshop</h2><span
              >Independent software & curious experiments</span
            ><a href="/software">View all projects ↗</a>
          </div>
          <div class="stories">
            {
              projects.map((project, i) => (
                <article class="story">
                  <a href={`/work/${project.slug}`}>
                    <>
                      <div class="story-meta">
                        <>
                          <span>
                            0{i + 1} / {project.category}
                          </span>
                          <span aria-hidden="true">↗</span>
                        </>
                      </div>
                      <figure>
                        <>
                          <img
                            src={`/project-screenshots/${project.image}`}
                            alt={`${project.name} application interface`}
                            width="800"
                            height="500"
                            loading="eager"
                          />
                          <figcaption>{project.name} — an independent project</figcaption>
                        </>
                      </figure>
                      <h3>{project.title}</h3>
                      <p>{project.description}</p>
                      <span class="read-story">Inside {project.name} →</span>
                    </>
                  </a>
                </article>
              ))
            }
          </div>
        </section>
        <div class="lower-columns">
          <section aria-labelledby="work-heading">
            <div class="section-heading">
              <h2 id="work-heading">In Good Company</h2><span>Selected work</span>
            </div>{
              work.map((project) => (
                <a class="work-item" href={`/work/${project.id}`}>
                  <>
                    <div>
                      <>
                        <h3>{project.data.company}</h3>
                        <p>{project.data.description}</p>
                      </>
                    </div>
                    <span aria-hidden="true">↗</span>
                  </>
                </a>
              ))
            }
          </section>
          <section aria-labelledby="writing-heading">
            <div class="section-heading">
              <h2 id="writing-heading">Field Notes</h2><a href="/blog">All writing ↗</a>
            </div>{
              posts.map((post) => (
                <a class="post" href={`/blog/${post.id}`}>
                  <>
                    <p class="eyebrow">Engineering / {post.data.readTime || '5 min read'}</p>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <span class="read-story">Read the story →</span>
                  </>
                </a>
              ))
            }
          </section>
        </div>
        <aside class="classified">
          <span class="eyebrow">Classifieds</span><p>For those who prefer a blinking cursor.</p><a
            href="/terminal">Enter the interactive terminal <span aria-hidden="true">↗</span></a
          >
        </aside>
      </main>
      <footer>
        <a class="footer-logo" href="/newspaper">The Peritissimus</a><span
          >Independently designed & engineered.</span
        ><a href="/contact">Get in touch ↗</a><span
          >© {new Date().getFullYear()} Kushal Patankar</span
        >
      </footer>
    </div>
  </body>
</html>
<script>
  document
    .querySelector<HTMLButtonElement>('#print-newspaper')
    ?.addEventListener('click', async () => {
      await document.fonts.ready;
      await Promise.all(Array.from(document.images, (image) => image.decode().catch(() => {})));
      window.print();
    });
</script>
<style>
  .print-tools {
    max-width: 1180px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font:
      14px 'Newsreader',
      serif;
  }
  .print-hint {
    margin-left: 12px;
    opacity: 0.7;
  }
  .print-tools button {
    white-space: nowrap;
    flex-shrink: 0;
    min-height: 44px;
    padding: 10px 16px;
    background: #24241f;
    color: #f2efe5;
    border: 1px solid #24241f;
    font:
      12px 'Barlow Semi Condensed',
      sans-serif;
    letter-spacing: 0.8px;
    cursor: pointer;
    transition:
      background 150ms,
      transform 150ms;
  }
  .print-tools button:hover {
    background: #46463c;
  }
  .print-tools button:active {
    transform: scale(0.96);
  }
  .print-tools button:focus-visible {
    outline: 2px solid #82472c;
    outline-offset: 4px;
  }
  @media screen and (max-width: 640px) {
    .print-tools {
      padding: 14px 20px 0;
      margin-bottom: 14px;
    }
    .print-hint {
      display: none;
    }
  }

  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  :global(html) {
    background: #e2dfd5;
    color: #24241f;
    scroll-behavior: smooth;
    color-scheme: light;
  }
  :global(body) {
    font-family: 'Newsreader', Georgia, serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.45;
    padding: 32px 24px;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(a:focus-visible) {
    outline: 2px solid #82472c;
    outline-offset: 5px;
  }
  :global(::selection) {
    background: #282820;
    color: #f2efe5;
  }
  .paper {
    max-width: 1180px;
    margin: auto;
    padding: 26px 44px 0;
    background: #f2efe5;
    box-shadow:
      0 2px 8px #0000000a,
      0 18px 60px #0000000a;
  }
  .edition,
  .dateline,
  nav,
  .eyebrow,
  .section-heading > span,
  .section-heading > a,
  .story-meta,
  figcaption,
  .read-story,
  .byline,
  .text-link,
  .notice > a,
  footer,
  .classified > a {
    font-family: 'Barlow Semi Condensed', sans-serif;
  }
  .edition {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    border-bottom: 1px solid #35352e;
    padding-bottom: 10px;
  }
  .masthead {
    display: block;
    text-align: center;
    font-size: clamp(54px, 9.5vw, 118px);
    font-weight: 600;
    letter-spacing: -6px;
    line-height: 1.1;
    padding: 22px 0 8px;
    white-space: nowrap;
  }
  .masthead > span {
    font-style: italic;
    font-weight: 400;
    font-size: 0.53em;
    letter-spacing: -3px;
  }
  .dateline {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-top: 3px double #35352e;
    border-bottom: 1px solid #35352e;
    padding: 9px 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .motto {
    font-family: 'Newsreader', serif;
    font-style: italic;
    text-transform: none;
    font-size: 14px;
    letter-spacing: 0;
  }
  nav {
    display: flex;
    justify-content: center;
    gap: 35px;
    border-bottom: 4px double #35352e;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  nav a {
    display: flex;
    align-items: center;
    min-height: 45px;
    gap: 8px;
  }
  nav a:hover,
  .text-link:hover,
  .read-story:hover,
  footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 245px;
    gap: 30px;
    padding: 32px 0;
    border-bottom: 1px solid #35352e;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(60px, 7.5vw, 94px);
    font-weight: 600;
    letter-spacing: -3.5px;
    line-height: 0.98;
    margin: 22px 0 20px;
    text-wrap: balance;
  }
  h1 em {
    font-weight: 400;
  }
  .standfirst {
    font-size: 25px;
    line-height: 1.25;
    max-width: 510px;
    margin-bottom: 25px;
    text-wrap: pretty;
  }
  .lead-bottom {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 25px;
    padding-top: 20px;
    border-top: 1px solid #aaa79d;
  }
  .lead-bottom > p {
    font-size: 16px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .dropcap:first-letter {
    float: left;
    font-size: 59px;
    line-height: 0.85;
    padding: 7px 7px 0 0;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    line-height: 1.8;
  }
  .byline a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .monogram {
    font-family: 'Newsreader', serif;
    font-size: 35px;
    font-style: italic;
    border: 1px solid #77776b;
    border-radius: 50%;
    height: 62px;
    width: 62px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .sidebar {
    border-left: 1px solid #aaa79d;
    padding-left: 28px;
    text-align: center;
  }
  .sidebar-heading {
    font-style: italic;
    font-size: 17px;
    border-bottom: 1px solid #aaa79d;
    padding-bottom: 9px;
  }
  .ornament {
    display: block;
    font-size: 46px;
    line-height: 1;
    margin: 19px 0 10px;
  }
  .sidebar h2 {
    font-size: 37px;
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -1px;
    margin-bottom: 14px;
  }
  .sidebar > p {
    font-size: 15px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
  }
  .notice {
    border: 3px double #77776b;
    margin-top: 17px;
    padding: 14px 10px;
  }
  .notice > p:nth-child(2) {
    font-size: 25px;
    line-height: 1.1;
    margin: 12px 0 4px;
  }
  .notice > a {
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0 13px;
    border-bottom: 1px solid #aaa79d;
  }
  .section-heading h2 {
    font-size: 27px;
    font-weight: 400;
    letter-spacing: -0.6px;
  }
  .section-heading > span,
  .section-heading > a {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }
  .section-heading > a {
    padding-block: 10px;
  }
  .stories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 22px 0 28px;
    border-bottom: 4px double #35352e;
  }
  .story {
    padding: 0 22px;
    border-right: 1px solid #aaa79d;
  }
  .story:first-child {
    padding-left: 0;
  }
  .story:last-child {
    padding-right: 0;
    border: 0;
  }
  .story-meta {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }
  figure img {
    display: block;
    width: 100%;
    height: 175px;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1);
    mix-blend-mode: multiply;
    outline: 1px solid #0000001a;
    outline-offset: -1px;
    transition: filter 200ms;
  }
  .story a:hover img {
    filter: grayscale(0);
  }
  figcaption {
    font-size: 10px;
    margin-top: 7px;
    letter-spacing: 0.4px;
  }
  .story h3 {
    font-size: 29px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.6px;
    margin: 17px 0 12px;
    text-wrap: balance;
  }
  .story p,
  .post > p:not(.eyebrow),
  .work-item p {
    font-size: 16px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .read-story {
    display: inline-block;
    font-size: 12px;
    padding: 15px 0 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .story a:hover h3,
  .post:hover h3,
  .work-item:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .lower-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    padding: 4px 0 24px;
  }
  .lower-columns > section + section {
    border-left: 1px solid #aaa79d;
    padding-left: 30px;
  }
  .work-item {
    display: flex;
    gap: 20px;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid #aaa79d;
  }
  .work-item:last-child {
    border-bottom: 0;
  }
  .work-item h3 {
    font-size: 25px;
    font-weight: 400;
    margin-bottom: 5px;
  }
  .post {
    display: block;
    padding: 20px 0;
  }
  .post + .post {
    border-top: 1px solid #aaa79d;
  }
  .post h3 {
    font-size: 28px;
    line-height: 1.1;
    font-weight: 400;
    margin: 10px 0;
    text-wrap: balance;
  }
  .classified {
    border-block: 3px double #35352e;
    padding: 17px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .classified p {
    font-size: 20px;
    font-style: italic;
  }
  .classified > a {
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 4px;
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 0;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
  .footer-logo {
    font-family: 'Newsreader', serif;
    font-size: 23px;
    text-transform: none;
    letter-spacing: -0.8px;
    font-weight: 600;
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    transform: translateY(-200%);
    background: #24241f;
    color: #fff;
    padding: 12px;
    z-index: 5;
  }
  .skip-link:focus {
    transform: none;
  }
  @media (min-width: 1500px) {
    body {
      padding-top: 48px;
    }
  }
  @media screen and (max-width: 950px) {
    .paper {
      padding-inline: 28px;
    }
    .lead {
      grid-template-columns: minmax(0, 1fr) 210px;
      gap: 24px;
    }
    .sidebar {
      padding-left: 24px;
    }
    .lead-bottom {
      grid-template-columns: 1fr;
    }
    .byline {
      border-top: 1px solid #aaa79d;
      padding-top: 15px;
    }
    .section-heading > span {
      display: none;
    }
    nav {
      gap: 23px;
    }
    figure img {
      height: 145px;
    }
    footer {
      flex-wrap: wrap;
    }
  }
  @media screen and (max-width: 640px) {
    :global(body) {
      padding: 0;
    }
    .paper {
      padding: 16px 20px 0;
      box-shadow: none;
    }
    .edition {
      font-size: 8px;
      letter-spacing: 0.8px;
      gap: 12px;
    }
    .masthead {
      font-size: clamp(39px, 10.7vw, 68px);
      letter-spacing: -2.5px;
      padding: 21px 0 13px;
    }
    .masthead > span {
      letter-spacing: -1px;
    }
    .dateline {
      font-size: 9px;
      letter-spacing: 0.3px;
    }
    .motto {
      display: none;
    }
    nav {
      flex-wrap: wrap;
      gap: 0;
      justify-content: space-between;
      padding: 4px 0;
    }
    nav a {
      justify-content: center;
      flex-basis: 33.333%;
      font-size: 10px;
      min-height: 40px;
      letter-spacing: 0.7px;
    }
    .lead {
      grid-template-columns: 1fr;
      padding: 25px 0;
      gap: 26px;
    }
    h1 {
      font-size: clamp(55px, 13.6vw, 82px);
      letter-spacing: -2.5px;
      margin-top: 20px;
    }
    .standfirst {
      font-size: 24px;
    }
    .lead-bottom {
      gap: 16px;
    }
    .sidebar {
      border-left: 0;
      border-top: 3px double #35352e;
      padding: 20px 0 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
      text-align: left;
    }
    .sidebar-heading {
      grid-column: 1/-1;
    }
    .ornament {
      display: none;
    }
    .sidebar h2 {
      font-size: 32px;
      margin: 7px 0 0;
    }
    .sidebar > p {
      grid-column: 1;
      grid-row: 3;
    }
    .text-link {
      grid-column: 1;
      grid-row: 4;
    }
    .notice {
      grid-column: 2;
      grid-row: 2/5;
      align-self: center;
      margin: 0;
      text-align: center;
    }
    .notice .eyebrow {
      font-size: 9px;
    }
    .section-heading h2 {
      font-size: 25px;
    }
    .stories {
      grid-template-columns: 1fr;
      padding-top: 0;
    }
    .story {
      padding: 22px 0;
      border-right: 0;
      border-bottom: 1px solid #aaa79d;
    }
    .story:last-child {
      padding: 22px 0 0;
