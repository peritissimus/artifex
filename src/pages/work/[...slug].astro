---
import Base from '../../layouts/Base.astro';
import ConsultingRelated from '../../components/ConsultingRelated.astro';
import { getCollection, render } from 'astro:content';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import StoneArtwork from '../../components/StoneArtwork.astro';
import { workSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const works = await getCollection('work');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);

const personalArtwork = {
  stone: 'memory',
  turntable: 'form',
  birdbrain: 'signal',
  tabbit: 'tabs',
  garatch: 'pulse',
  fitroom: 'fit',
  kaze: 'kaze',
  reelserver: 'reelserver',
  irem: 'irem',
  dotfiles: 'dotfiles',
  blueprint: 'plan',
  strid: 'strid',
  paperfolio: 'paperfolio',
} as const;

const artworkVariant = personalArtwork[work.id as keyof typeof personalArtwork];

// Parse markdown bold syntax in achievements
function parseMarkdown(text: string): string {
  return text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
}

const kindLabel = work.data.kind === 'personal' ? 'Personal Project' : 'Work Experience';
const ogImage = work.data.ogImage || `/og/work/${work.id}.png`;
const detailSchema = workSchema({
  title: work.data.title,
  description: work.data.description,
  slug: work.id,
  kind: work.data.kind,
  role: work.data.role,
  technologies: work.data.technologies,
  externalUrl: work.data.externalUrl,
  image: ogImage,
});
const breadcrumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  {
    name: work.data.kind === 'personal' ? 'Software' : 'About',
    path: work.data.kind === 'personal' ? '/software' : '/about',
  },
  { name: work.data.title, path: `/work/${work.id}` },
]);
---

<Base
  title={work.data.seoTitle
    ? `${work.data.seoTitle} - peritissimus`
    : `${work.data.title} - ${kindLabel} - peritissimus`}
  ogTitle={`${work.data.title} — ${work.data.role}`}
  description={work.data.description}
  ogImage={ogImage}
  currentPath={`/work/${work.id}`}
  jsonLd={[detailSchema, breadcrumbs]}
>
  <article
    class:list={[
      'content-section',
      'work-detail',
      { 'work-detail--personal': work.data.kind === 'personal' },
    ]}
  >
    <div class="section-inner">
      <header class="work-header">
        <div class="work-back">
          <a href={work.data.kind === 'personal' ? '/software' : '/about'}>
            ← {work.data.kind === 'personal' ? 'Back to Personal Software' : 'Back to Timeline'}
          </a>
        </div>
        <h1 class="work-company">{work.data.title}</h1>
        {
          work.data.externalUrl && (
            <a
              href={work.data.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="work-link"
            >
              {new URL(work.data.externalUrl).hostname} →
            </a>
          )
        }
      </header>
      {
        work.data.kind === 'personal' && artworkVariant && (
          <figure class={`project-blueprint project-blueprint--${work.id}`}>
            {work.id === 'stone' ? (
              <StoneArtwork />
            ) : (
              <>
                <div class="project-blueprint-labels" aria-hidden="true">
                  <span>Product study</span>
                  <span>Archive {String(work.data.order - 100).padStart(2, '0')}</span>
                </div>
                <ProjectArtwork variant={artworkVariant} detail="blueprint" />
              </>
            )}
            <figcaption>{work.data.description}</figcaption>
          </figure>
        )
      }

      <div class="post-content">
        <div class="work-section">
          <h3>Overview</h3>
          <Content />
        </div>
      </div>

      {
        work.data.kind === 'personal' && work.data.screenshot && (
          <figure class:list={['project-screenshot', `project-screenshot--${work.id}`]}>
            <img
              src={work.data.screenshot.src}
              alt={work.data.screenshot.alt}
              width={work.data.screenshot.width}
              height={work.data.screenshot.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{work.data.screenshot.caption}</figcaption>
          </figure>
        )
      }

      <div class="post-content">
        {
          work.data.achievements.length > 0 && (
            <div class="work-section">
              <h3>{work.data.kind === 'personal' ? 'Technical highlights' : 'Key Achievements'}</h3>
              <ul class="achievement-list">
                {work.data.achievements.map((achievement) => (
                  <li set:html={parseMarkdown(achievement)} />
                ))}
              </ul>
            </div>
          )
        }

        {
          work.data.stats && work.data.stats.length > 0 && (
            <div class="work-section">
              <h3>Impact</h3>
              <div class="impact-stats">
                {work.data.stats.map((stat) => (
                  <div class="stat-item">
                    <div class="stat-value">{stat.value}</div>
                    <div class="stat-label">{stat.label}</div>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        {
          work.data.outcome && (
            <div class="work-section">
              <h3>Outcome</h3>
              <p>{work.data.outcome}</p>
            </div>
          )
        }
      </div>
      <footer class="detail-meta" aria-label="Project details">
        <dl>
          <div>
            <dt>Type</dt>
            <dd>{kindLabel}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{work.data.role}</dd>
          </div>
          <div>
            <dt>Period</dt>
            <dd>{work.data.dateRange}</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{work.data.location}</dd>
          </div>
          {
            work.data.technologies.length > 0 && (
              <div>
                <dt>Technologies</dt>
                <dd>{work.data.technologies.join(', ')}</dd>
              </div>
            )
          }
        </dl>
      </footer>
      <ConsultingRelated path={`/work/${work.id}`} />
    </div>
  </article>
</Base>
