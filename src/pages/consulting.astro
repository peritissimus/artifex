---
import Base from '../layouts/Base.astro';
import ConsultingInquiry from '../components/ConsultingInquiry.astro';
import {
  consultingDescription,
  consultingIntroduction,
  consultingServices,
  consultingTitle,
  consultingWorkingStyle,
  servicePath,
} from '../lib/consulting';
import { breadcrumbSchema, personSchema } from '../lib/schema';
---

<Base
  title={consultingTitle}
  description={consultingDescription}
  ogImage="/og/home.png"
  currentPath="/consulting"
  jsonLd={[
    personSchema,
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Consulting', path: '/consulting' },
    ]),
  ]}
>
  <section class="content-section page-consulting">
    <div class="section-inner consulting-inner">
      <header class="consulting-hero">
        <p class="page-kicker">Independent engineering · Kushal Patankar</p>
        <h1 class="section-title">Thoughtful engineering for AI products.</h1>
        <p class="consulting-lede">{consultingIntroduction}</p>
        <a class="consulting-text-link" href="#project-inquiry">Discuss a project →</a>
      </header>

      <section class="consulting-section" aria-labelledby="services-heading">
        <h2 id="services-heading">Where I can help</h2>
        <div class="consulting-services">
          {
            consultingServices.map((service, index) => (
              <a class="consulting-service-link" href={servicePath(service)}>
                <span class="consulting-number" aria-hidden="true">
                  0{index + 1}
                </span>
                <span>
                  <>
                    <h3>{service.name}</h3>
                    <p>{service.summary}</p>
                  </>
                </span>
                <span class="consulting-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="consulting-section" aria-labelledby="working-style-heading">
        <h2 id="working-style-heading">Start with the question.</h2>
        <p>{consultingWorkingStyle}</p>
        <p>
          I’m currently building at Zoca. We agree scope, availability, and fees before starting.
        </p>
      </section>

      <section class="consulting-section" aria-labelledby="relevant-work-heading">
        <h2 id="relevant-work-heading">Relevant engineering work</h2>
        <p>
          My background includes AI content and website workflows at <a href="/work/zoca">Zoca</a>,
          context-aware personalization at <a href="/work/brihaspati">Brihaspati</a>, and
          distributed media processing at <a href="/work/dubverse">Dubverse</a>. These examples come
          from my engineering roles.
        </p>
        <p>
          For the reasoning behind those systems, read <a href="/blog/scaling-llm-applications"
            >Scaling LLM Applications</a
          > and <a href="/blog/celery-redis-media-pipeline"
            >Building Media Pipelines with Celery and Redis</a
          >. You can also read <a href="/about">about my background</a> or view my <a href="/resume"
            >résumé</a
          >.
        </p>
      </section>
      <ConsultingInquiry />
    </div>
  </section>
</Base>
