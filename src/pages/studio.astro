---
import SEO from '../components/SEO.astro';
import '../styles/main.scss';
import '../styles/studio.scss';

// ── The work, pulled from Instagram @149.kush and kept in /public/art ──────
const hero = {
  src: '/art/forget.jpg',
  title: 'forget.',
  medium: 'Digital painting',
  year: '2020',
  w: 1000,
  h: 1000,
};

const ink = [
  {
    src: '/art/inktober-day8-teeth.jpg',
    title: 'Teeth',
    series: 'Inktober 2020 · Day 8',
    medium: 'Pen & ink',
    year: '2020',
    w: 1440,
    h: 1080,
  },
  {
    src: '/art/inktober-day7-fancy.jpg',
    title: 'Fancy',
    series: 'Inktober 2020 · Day 7',
    medium: 'Pen & ink',
    year: '2020',
    w: 1440,
    h: 1080,
  },
];

const gallery = [
  { src: '/art/remember.jpg', title: 'Remember?', medium: 'Digital painting', year: '2021', w: 1000, h: 1000 },
  { src: '/art/yellow.jpg', title: 'yellow.', medium: 'Digital painting', year: '2020', w: 1000, h: 1000 },
  { src: '/art/cards1-snow.jpg', title: 'Cards — I', medium: 'Comic', year: '2020', w: 1000, h: 1000 },
  { src: '/art/ding.jpg', title: 'Ding.', medium: 'Comic', year: '2021', w: 1000, h: 1000 },
  { src: '/art/poof.jpg', title: 'Poof.', medium: 'Digital', year: '2020', w: 1000, h: 1000 },
  { src: '/art/bloop.jpg', title: 'Bloop.', medium: 'Digital', year: '2021', w: 1000, h: 1000 },
];

const desk = {
  src: '/art/cards2-desk.jpg',
  title: 'Cards — II',
  medium: 'Digital painting',
  year: '2020',
  w: 1000,
  h: 1000,
};

const cap = (a: { title: string; medium: string; year: string }) =>
  `${a.title} · ${a.medium} · ${a.year}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0a08" media="(prefers-color-scheme: dark)" />
    <SEO
      markdownPath="/studio.md"
      title="The Studio — Kushal Patankar (149.KUSH)"
      ogTitle="The Studio — ink, paint, and systems"
      description="The artwork of Kushal Patankar (@149.kush): pen-and-ink Inktober drawings, moody digital paintings, and short comics — by an artist who became an engineer."
      ogImage="/og/home.png"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/art/forget.jpg" />
  </head>

  <body class="studio-page">
    <i class="reg reg-tl" aria-hidden="true"></i>
    <i class="reg reg-tr" aria-hidden="true"></i>
    <i class="reg reg-bl" aria-hidden="true"></i>
    <i class="reg reg-br" aria-hidden="true"></i>

    <header class="studio-nav">
      <a class="nav-home" href="/"><span aria-hidden="true">↖</span> PERITISSIMUS</a>
      <a
        class="nav-ig"
        href="https://instagram.com/149.kush"
        target="_blank"
        rel="noopener noreferrer">@149.KUSH <span aria-hidden="true">↗</span></a
      >
    </header>

    <main class="sheet">
      <!-- ─── Masthead ─────────────────────────────────────────────── -->
      <section class="masthead">
        <div class="mast-copy" data-stagger>
          <p class="kick reveal">The studio of Kushal Patankar · @149.kush</p>
          <h1 class="mast-title reveal">
            I started with a nib and a&nbsp;straight line.<br />
            <em>Now I draw systems.</em>
          </h1>
          <p class="mast-lede reveal">
            Pen-and-ink drawings, digital paintings, and short comics by Kushal Patankar.
          </p>
          <div class="mast-meta reveal" aria-hidden="true">
            <span>INK · PAINT · PANEL</span>
            <span class="dot">·</span>
            <span>2019 — 2021</span>
          </div>
        </div>

        <figure class="mast-art reveal">
          <button
            class="art-open"
            data-src={hero.src}
            data-title={hero.title}
            data-cap={cap(hero)}
            aria-label={`Open ${hero.title} full size`}
          >
            <img src={hero.src} width={hero.w} height={hero.h} alt={`${hero.title} — a lone figure at the end of a misty dock`} fetchpriority="high" />
          </button>
          <figcaption><em>{hero.title}</em> <span class="mono">{hero.medium} · {hero.year}</span></figcaption>
        </figure>
      </section>

      <!-- ─── Ink motif: the line that became everything ───────────── -->
      <div class="ink-motif" aria-hidden="true">
        <svg class="inkwork" viewBox="0 0 360 180" role="presentation">
          <path
            class="flourish draw"
            d="M14 120 C 60 70, 50 40, 96 48 C 140 56, 128 132, 174 116 C 224 100, 210 48, 262 58"
          />
          <g class="nib">
            <path d="M262 58 l24 -14 -6 18 -14 8 z" />
            <path d="M274 56 l8 -5" class="nib-slit" />
          </g>
          <path class="vector draw" d="M292 96 C 312 70, 330 120, 350 92" />
        </svg>
      </div>

      <!-- ─── Origin: pen & ink ────────────────────────────────────── -->
      <section class="origin" aria-labelledby="origin-head">
        <div class="section-head reveal">
          <h2 id="origin-head">Pen &amp; ink</h2>
          <p class="section-sub">
            From my Inktober sketchbook.
          </p>
        </div>
        <div class="ink-row" data-stagger>
          {
            ink.map((art) => (
              <figure class="ink-plate reveal">
                <button class="art-open" data-src={art.src} data-title={art.title} data-cap={cap(art)} aria-label={`Open ${art.title} full size`}>
                  <img src={art.src} width={art.w} height={art.h} alt={`${art.title} — pen and ink drawing in a sketchbook`} loading="lazy" decoding="async" />
                </button>
                <figcaption>
                  <span class="ink-title"><em>{art.title}</em></span>
                  <span class="mono ink-meta">{art.series}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <hr class="rule" />

      <!-- ─── The gallery ──────────────────────────────────────────── -->
      <section class="gallery-section" aria-labelledby="gallery-head">
        <div class="section-head reveal">
          <h2 id="gallery-head">Paintings &amp; panels</h2>
          <p class="section-sub">
            Click any piece to see it whole.
          </p>
        </div>
        <div class="gallery" data-stagger>
          {
            gallery.map((art) => (
              <figure class="art reveal">
                <button class="art-open" data-src={art.src} data-title={art.title} data-cap={cap(art)} aria-label={`Open ${art.title} full size`}>
                  <img src={art.src} width={art.w} height={art.h} alt={`${art.title} — ${art.medium.toLowerCase()} by Kushal Patankar`} loading="lazy" decoding="async" />
                  <span class="art-hover mono" aria-hidden="true">View</span>
                </button>
                <figcaption>
                  <span class="art-title"><em>{art.title}</em></span>
                  <span class="mono art-meta">{art.medium} · {art.year}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <hr class="rule" />

      <!-- ─── The desk: where art became engineering ───────────────── -->
      <section class="desk-section" aria-labelledby="desk-head">
        <figure class="desk-art reveal">
          <button class="art-open" data-src={desk.src} data-title={desk.title} data-cap={cap(desk)} aria-label={`Open ${desk.title} full size`}>
            <img src={desk.src} width={desk.w} height={desk.h} alt="A figure at a desk at night, headphones on, lit by a monitor" loading="lazy" decoding="async" />
          </button>
          <figcaption><em>{desk.title}</em> <span class="mono">{desk.medium} · {desk.year}</span></figcaption>
        </figure>
        <div class="desk-copy reveal">
          <h2 id="desk-head">Then I became the one at the desk</h2>
          <p>
            Somewhere between the drawings I stopped being only the artist and became the person in
            this painting — headphones on, lit by a screen, building past midnight. The discipline
            carried over intact: see the finished thing, commit the line, take it to the end.
          </p>
          <div class="desk-links">
            <a href="/software">See the software <span aria-hidden="true">→</span></a>
            <a href="/resume">The résumé <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <!-- ─── Colophon + chop seal ─────────────────────────────────── -->
      <footer class="colophon">
        <div class="colo-copy reveal">
          <p class="colo-line">
            Drawn by Kushal Patankar — @149.kush. The full feed, and whatever I make next, lives on
            Instagram.
          </p>
          <div class="colo-links">
            <a href="https://instagram.com/149.kush" target="_blank" rel="noopener noreferrer"
              >See the ink <span aria-hidden="true">→</span></a
            >
            <a href="/contact">Commission something <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="chop" aria-label="Artist's seal: 149.KUSH">
          <span class="chop-149">149</span>
          <span class="chop-kush">KUSH</span>
        </div>
      </footer>
    </main>

    <!-- Lightbox -->
    <div class="lightbox" hidden tabindex="-1" aria-modal="true" role="dialog" aria-label="Artwork viewer">
      <button class="lb-close" aria-label="Close">✕</button>
      <figure class="lb-figure">
        <img class="lb-img" src="" alt="" />
        <figcaption class="lb-cap mono"></figcaption>
      </figure>
    </div>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const easeStd = ((x1, y1, x2, y2) => {
        const A = (a: number, b: number) => 1 - 3 * b + 3 * a;
        const B = (a: number, b: number) => 3 * b - 6 * a;
        const C = (a: number) => 3 * a;
        const calc = (t: number, a: number, b: number) => ((A(a, b) * t + B(a, b)) * t + C(a)) * t;
        const slope = (t: number, a: number, b: number) =>
          3 * A(a, b) * t * t + 2 * B(a, b) * t + C(a);
        return (x: number) => {
          if (x <= 0) return 0;
          if (x >= 1) return 1;
          let t = x;
          for (let i = 0; i < 5; i++) {
            const s = slope(t, x1, x2);
            if (s === 0) break;
            t -= (calc(t, x1, x2) - x) / s;
          }
          return calc(t, y1, y2);
        };
      })(0.2, 0, 0, 1);

      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        Array.from(group.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty('--i', String(i));
        });
      });

      const primeDraws = () => {
        document.querySelectorAll<SVGGeometryElement>('.draw').forEach((el) => {
          try {
            const len = el.getTotalLength();
            el.style.setProperty('--len', `${len}`);
            el.style.strokeDasharray = `${len}`;
            el.style.strokeDashoffset = `${len}`;
          } catch {
            /* ignore */
          }
        });
      };

      const revealTargets = document.querySelectorAll<HTMLElement>('.reveal');
      const inkTargets = document.querySelectorAll<HTMLElement>('.inkwork, .chop');

      if (reduce) {
        revealTargets.forEach((el) => el.classList.add('in'));
        inkTargets.forEach((el) => el.classList.add('is-inked'));
        document.querySelectorAll<SVGGeometryElement>('.draw').forEach((el) => {
          el.style.strokeDashoffset = '0';
          el.style.opacity = '1';
        });
      } else {
        primeDraws();

        const ro = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                ro.unobserve(en.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -7% 0px' }
        );
        revealTargets.forEach((el) => ro.observe(el));

        // the ink motif draws itself: nib travels the flourish
        const runInk = (svg: SVGSVGElement) => {
          const flourish = svg.querySelector<SVGPathElement>('.flourish');
          const nib = svg.querySelector<SVGGElement>('.nib');
          if (!flourish || !nib) return;
          svg.classList.add('js-hero');
          const L = flourish.getTotalLength();
          flourish.style.strokeDasharray = `${L}`;
          flourish.style.strokeDashoffset = `${L}`;
          flourish.style.opacity = '1';
          const anchor = flourish.getPointAtLength(L);
          const angleAt = (s: number) => {
            const a = flourish.getPointAtLength(Math.max(0, s - 1.5));
            const b = flourish.getPointAtLength(Math.min(L, s + 1.5));
            return (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
          };
          const endAngle = angleAt(L);
          nib.style.opacity = '0';
          const start = performance.now() + 200;
          const frame = (now: number) => {
            const raw = (now - start) / 1500;
            if (raw < 0) {
              requestAnimationFrame(frame);
              return;
            }
            const p = Math.min(1, raw);
            const e = easeStd(p);
            flourish.style.strokeDashoffset = `${L * (1 - e)}`;
            const pt = flourish.getPointAtLength(L * e);
            const ang = angleAt(L * e) - endAngle;
            nib.style.opacity = '1';
            nib.setAttribute(
              'transform',
              `translate(${(pt.x - anchor.x).toFixed(2)} ${(pt.y - anchor.y).toFixed(2)}) ` +
                `rotate(${ang.toFixed(2)} ${anchor.x.toFixed(2)} ${anchor.y.toFixed(2)})`
            );
            if (p < 1) requestAnimationFrame(frame);
            else nib.removeAttribute('transform');
          };
          requestAnimationFrame(frame);
        };

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (!en.isIntersecting) return;
              en.target.classList.add('is-inked');
              if (en.target.classList.contains('inkwork')) runInk(en.target as SVGSVGElement);
              io.unobserve(en.target);
            });
          },
          { threshold: 0.4 }
        );
        inkTargets.forEach((el) => io.observe(el));
      }

      // ── Lightbox ────────────────────────────────────────────────
      const lb = document.querySelector<HTMLElement>('.lightbox');
      const lbImg = lb?.querySelector<HTMLImageElement>('.lb-img');
      const lbCap = lb?.querySelector<HTMLElement>('.lb-cap');
      let lastFocus: HTMLElement | null = null;

      const openLb = (btn: HTMLElement) => {
        if (!lb || !lbImg || !lbCap) return;
        lastFocus = btn;
        lbImg.src = btn.dataset.src || '';
        lbImg.alt = btn.dataset.title || '';
        lbCap.textContent = btn.dataset.cap || '';
        lb.hidden = false;
        requestAnimationFrame(() => lb.classList.add('open'));
        document.body.style.overflow = 'hidden';
        (lb.querySelector('.lb-close') as HTMLElement)?.focus();
      };
      const closeLb = () => {
        if (!lb) return;
        lb.classList.remove('open');
        document.body.style.overflow = '';
        window.setTimeout(() => {
          lb.hidden = true;
        }, 220);
        lastFocus?.focus();
      };

      document.querySelectorAll<HTMLElement>('.art-open').forEach((btn) => {
        btn.addEventListener('click', () => openLb(btn));
      });
      lb?.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === lb || t.classList.contains('lb-close')) closeLb();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lb && !lb.hidden) closeLb();
      });
    </script>
  </body>
</html>
