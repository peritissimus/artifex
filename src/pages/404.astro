---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found - peritissimus"
  description="This page doesn't exist. Head back to the homepage or browse the blog."
  currentPath="/404"
  noindex={true}
>
  <section class="content-section page-not-found">
    <div class="section-inner">
      <p class="page-kicker">404</p>
      <h1 class="section-title">Page not found</h1>
      <p class="not-found-copy">
        The page you're looking for doesn't exist or has moved. Nothing here sits behind
        a login, so a 404 means the URL is wrong rather than that access was denied.
      </p>
      <nav class="not-found-links" aria-label="Suggested pages">
        <a href="/">← Back to home</a>
        <a href="/blog">Browse the blog</a>
        <a href="/software">Personal software</a>
        <a href="/contact">Contact</a>
      </nav>
      <p class="not-found-machine">
        Reading this with a script? The same 404 is served as Markdown to anything that
        does not ask for HTML — or fetch <a href="/404.md">/404.md</a> directly. The full
        index is at <a href="/llms.txt">/llms.txt</a> and <a href="/sitemap-index.xml"
          >/sitemap-index.xml</a
        >.
      </p>
    </div>
  </section>
</Base>

<style lang="scss">
  .page-not-found {
    .not-found-copy {
      margin-top: 1rem;
      max-width: 32rem;
    }

    .not-found-machine {
      margin-top: 2rem;
      max-width: 34rem;
      font-size: 0.9375rem;
      color: var(--muted);

      a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;

        &:hover {
          color: var(--fg);
        }
      }
    }

    .not-found-links {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;

      a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;

        &:hover {
          opacity: 0.7;
        }
      }
    }
  }
</style>
