---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found - peritissimus"
  description="This page doesn't exist. Head back to the homepage or browse the blog."
  currentPath="/404"
  noindex={true}
>
  <section class="content-section page-not-found">
    <div class="section-inner">
      <p class="page-kicker">404</p>
      <h1 class="section-title">Page not found</h1>
      <p class="not-found-copy">
        The page you're looking for doesn't exist or has moved.
      </p>
      <nav class="not-found-links" aria-label="Suggested pages">
        <a href="/">← Back to home</a>
        <a href="/blog">Browse the blog</a>
        <a href="/software">Personal software</a>
      </nav>
    </div>
  </section>
</Base>

<style lang="scss">
  .page-not-found {
    .not-found-copy {
      margin-top: 1rem;
      max-width: 32rem;
    }

    .not-found-links {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;

      a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;

        &:hover {
          opacity: 0.7;
        }
      }
    }
  }
</style>
