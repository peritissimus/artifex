---
import Base from '../layouts/Base.astro';
import { consultingServices, inquiryDescription, inquiryHref } from '../lib/consulting';
---

<Base
  title="Consulting & Contact — Kushal Patankar"
  description="Discuss an applied AI engineering, infrastructure, or distributed systems project with Kushal Patankar. Consulting inquiries and engineering conversations welcome."
  ogImage="/og/contact.png"
  currentPath="/contact"
>
  <section id="contact" class="content-section page-contact">
    <div class="section-inner">
      <p class="page-kicker">A conversation is a good start</p>
      <h1 class="section-title">Contact</h1>
      <div class="section-content">
        <p class="lede">
          Have a product to build or a system to untangle? I’m open to focused consulting
          conversations in applied AI engineering, scalable AI infrastructure, and distributed
          systems.
        </p>

        <p class="contact-availability">
          Currently building at <a href="/work/zoca">Zoca</a>. We can discuss scope and availability
          once the problem is clear. You can read about <a href="/consulting">working together</a>;
          founding and staff engineering conversations are welcome too.
        </p>

        <section class="contact-project" aria-labelledby="contact-project-heading">
          <h2 id="contact-project-heading">Tell me about the project.</h2>
          <p>{inquiryDescription}</p>
          <label for="consulting-service">What would you like to discuss?</label>
          <select id="consulting-service">
            <option value="general" data-email={inquiryHref()}
              >A project or engineering question</option
            >
            {
              consultingServices.map((service) => (
                <option value={service.slug} data-email={inquiryHref(service.slug)}>
                  {service.name}
                </option>
              ))
            }
          </select>
          <a
            id="contact-project-email"
            class="consulting-button"
            href={inquiryHref()}
            data-consulting-service="general"
            >Email me about a project <span aria-hidden="true">↗</span></a
          >
          <p class="contact-project-note">
            This opens a draft in your email app. Nothing is submitted through the website.
          </p>
        </section>

        <div class="contact-links">
          <a href="/resume" class="contact-link">
            <span class="link-icon" aria-hidden="true">CV</span>
            <span class="link-copy">
              <span class="link-label">Résumé</span>
              <span class="link-value">Experience, skills, and background</span>
            </span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
          <a href="mailto:149.kush@gmail.com" class="contact-link">
            <span class="link-icon" aria-hidden="true">@</span>
            <span class="link-copy">
              <span class="link-label">Email</span>
              <span class="link-value">149.kush@gmail.com</span>
            </span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="https://github.com/peritissimus"
            target="_blank"
            rel="noopener"
            class="contact-link"
          >
            <span class="link-icon" aria-hidden="true">GH</span>
            <span class="link-copy">
              <span class="link-label">GitHub</span>
              <span class="link-value">github.com/peritissimus</span>
            </span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="https://twitter.com/peritissimus_"
            target="_blank"
            rel="noopener"
            class="contact-link"
          >
            <span class="link-icon" aria-hidden="true">X</span>
            <span class="link-copy">
              <span class="link-label">Twitter</span>
              <span class="link-value">@peritissimus_</span>
            </span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="https://linkedin.com/in/peritissimus"
            target="_blank"
            rel="noopener"
            class="contact-link"
          >
            <span class="link-icon" aria-hidden="true">IN</span>
            <span class="link-copy">
              <span class="link-label">LinkedIn</span>
              <span class="link-value">linkedin.com/in/peritissimus</span>
            </span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const serviceSelect = document.querySelector<HTMLSelectElement>('#consulting-service');
  const emailLink = document.querySelector<HTMLAnchorElement>('#contact-project-email');
  if (serviceSelect && emailLink) {
    const requested = new URLSearchParams(location.search).get('service');
    if (
      requested &&
      Array.from(serviceSelect.options).some((option) => option.value === requested)
    ) {
      serviceSelect.value = requested;
    }
    const updateInquiry = () => {
      const option = serviceSelect.selectedOptions[0];
      emailLink.href = option.dataset.email || emailLink.href;
      emailLink.dataset.consultingService = option.value;
    };
    updateInquiry();
    serviceSelect.addEventListener('change', updateInquiry);
  }
</script>
